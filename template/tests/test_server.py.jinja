def test_build_repository_honours_db_path(tmp_path, monkeypatch) -> None:
    path = tmp_path / "nested" / "tasks.db"
    monkeypatch.setenv("DB_PATH", str(path))
    repository = build_repository()
    assert isinstance(repository, SqliteTaskRepository)
    repository.close()
    assert path.exists()


def test_default_database_is_outside_the_working_directory(tmp_path, monkeypatch) -> None:
    monkeypatch.delenv("DB_PATH", raising=False)
    monkeypatch.chdir(tmp_path)
    from {{ module_name }}.server import database_path

    assert tmp_path not in database_path().parents
