ISSUER = "https://issuer.test"
AUDIENCE = "{{ project_slug }}"


def configure_key(monkeypatch, keys: RSAKeyPair) -> None:
    monkeypatch.setenv("MCP_JWT_PUBLIC_KEY", keys.public_key)
    monkeypatch.setenv("MCP_JWT_ISSUER", ISSUER)
    monkeypatch.setenv("MCP_JWT_AUDIENCE", AUDIENCE)
    monkeypatch.delenv("MCP_JWT_JWKS_URI", raising=False)


async def test_token_signed_with_the_configured_key_is_accepted(monkeypatch) -> None:
    keys = RSAKeyPair.generate()
    configure_key(monkeypatch, keys)
    token = keys.create_token(subject="tester", issuer=ISSUER, audience=AUDIENCE)
    assert await build_auth().verify_token(token) is not None


async def test_token_signed_with_another_key_is_rejected(monkeypatch) -> None:
    configure_key(monkeypatch, RSAKeyPair.generate())
    token = RSAKeyPair.generate().create_token(subject="tester", issuer=ISSUER, audience=AUDIENCE)
    assert await build_auth().verify_token(token) is None


def test_bearer_auth_refuses_to_start_without_a_key(monkeypatch) -> None:
    monkeypatch.delenv("MCP_JWT_PUBLIC_KEY", raising=False)
    monkeypatch.delenv("MCP_JWT_JWKS_URI", raising=False)
    with pytest.raises(RuntimeError, match="MCP_JWT_PUBLIC_KEY"):
        build_auth()
