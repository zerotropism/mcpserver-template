[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = {{ description | tojson }}
readme = "README.md"
license = "MIT"
requires-python = ">=3.12"
dependencies = [
    "fastmcp>=4,<5",
{%- if backend == "sqlite" %}
    "platformdirs>=4",
{%- endif %}
    "pydantic>=2.10",
]

[project.scripts]
{{ project_slug }} = "{{ module_name }}.server:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[dependency-groups]
dev = [
    "pytest>=9.1",
    "pytest-asyncio>=1.4",
    "ruff>=0.16",
]

[tool.pytest.ini_options]
asyncio_mode = "auto"
