# Build stage: install the locked dependencies, then the project, into a virtual environment.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

# Runtime stage: the virtual environment only, run by an unprivileged user.
FROM python:3.12-slim-bookworm
RUN useradd --create-home --uid 1000 app{% if backend == "sqlite" %} && mkdir /data && chown app:app /data{% endif %}
COPY --from=build --chown=app:app /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8000{% if backend == "sqlite" %} \
    DB_PATH=/data/tasks.db{% endif %}
USER app
EXPOSE 8000
{%- if backend == "sqlite" %}
VOLUME /data
{%- endif %}
CMD ["{{ project_slug }}"]
